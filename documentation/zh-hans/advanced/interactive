## 使用示例

### 示例 1: 交互式项目初始化

```typescript
import { Cli, tui } from '@itools/frontend'

async function interactiveInit() {
  console.log("=== iTools 项目初始化 ===")
  
  // 获取项目名称
  const name = tui.prompt("请输入项目名称:")
  if (!name) {
    console.log("项目名称不能为空")
    return
  }
  
  // 选择项目模板
  const templates = ["默认模板", "TypeScript 模板", "React 模板", "Vue 模板"]
  const templateChoice = tui.select(templates, "请选择项目模板:")
  if (templateChoice === undefined) {
    console.log("请选择一个模板")
    return
  }
  const template = templates[templateChoice]
  
  // 显示进度
  console.log(`\n正在初始化项目 "${name}" 使用 "${template}" 模板...`)
  const pb = tui.ProgressBar.new(100, 50)
  for (let i = 0; i <= 100; i++) {
    pb.update(i)
    await new Promise(resolve => setTimeout(resolve, 30))
  }
  pb.finish()
  
  console.log(`\n✅ 项目 "${name}" 初始化完成！`)
  console.log(`📁 项目目录: ./${name}`)
  console.log(`📖 下一步: cd ${name} && pnpm install`)
}

interactiveInit()
```

### 示例 2: 交互式构建配置

```typescript
import { ConfigManager, tui } from '@itools/frontend'

async function interactiveConfig() {
  console.log("=== iTools 构建配置 ===")
  
  // 创建配置
  const config = {
    title: tui.prompt("请输入项目标题 (默认: iTools Project):") || "iTools Project",
    description: tui.prompt("请输入项目描述 (默认: Interactive tools framework):") || "Interactive tools framework",
    lang: tui.select(["en", "zh-CN", "ja", "ko"], "请选择语言 (默认: en):") || 0,
    themeConfig: {
      nav: [
        { text: "首页", link: "/" },
        { text: "指南", link: "/guide/" }
      ]
    }
  }
  
  // 确认配置
  console.log("\n配置预览:")
  console.log(JSON.stringify(config, null, 2))
  
  const confirm = tui.select(["确认", "取消"], "是否保存配置?")
  if (confirm === 0) {
    const manager = ConfigManager.fromObject(config)
    console.log("✅ 配置已保存")
  } else {
    console.log("❌ 配置已取消")
  }
}

interactiveConfig()
```

