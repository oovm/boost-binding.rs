## 自定义交互

您可以根据需要自定义交互式功能，创建更加符合特定场景的用户体验。

### 自定义 TUI 组件

```typescript
import { tui } from '@itools/frontend'

// 自定义确认对话框
function confirm(message: string): boolean {
  const choices = ["是", "否"]
  const choice = tui.select(choices, message)
  return choice === 0
}

// 自定义进度显示
async function withProgress<T>(task: () => Promise<T>, message: string): Promise<T> {
  console.log(message)
  const pb = tui.ProgressBar.new(100, 40)
  
  // 模拟进度更新
  let progress = 0
  const progressInterval = setInterval(() => {
    progress = Math.min(progress + 5, 100)
    pb.update(progress)
  }, 200)
  
  const result = await task()
  
  clearInterval(progressInterval)
  pb.update(100)
  pb.finish()
  
  return result
}

// 使用示例
async function main() {
  if (confirm("是否继续?")) {
    const result = await withProgress(
      () => new Promise(resolve => setTimeout(() => resolve("完成"), 4000)),
      "正在执行任务..."
    )
    console.log(`任务结果: ${result}`)
  }
}

main()
```

### 自定义命令

```typescript
import { Cli } from '@itools/frontend'

// 扩展命令解析
class CustomCli extends Cli {
  static parse(args: string[]): CustomCli {
    // 自定义命令解析逻辑
    const command = args[0] as any
    const options: any = {}
    
    switch (command) {
      case 'custom':
        options.param = args[1]
        break
      default:
        // 调用父类解析
        const baseCli = super.parse(args)
        return new CustomCli(baseCli.getCommand() as any, baseCli.getOptions() as any)
    }
    
    return new CustomCli(command, options)
  }
  
  async execute(): Promise<void> {
    if (this.getCommand() === 'custom') {
      const param = this.getOptions().param
      console.log(`执行自定义命令，参数: ${param}`)
      // 自定义命令逻辑
    } else {
      // 调用父类执行
      await super.execute()
    }
  }
}

// 使用示例
async function main() {
  const cli = CustomCli.parse(['custom', 'test'])
  await cli.execute()
}

main()
```

